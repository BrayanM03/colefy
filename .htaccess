RewriteEngine On
# Evita que se aplique a archivos reales (imágenes, css, js)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Envía todo a index.php pasando la ruta como parámetro 'url'
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

<FilesMatch "(phpinfo|wp-config|wp-login|info)\.php$">
    Require all denied
</FilesMatch>